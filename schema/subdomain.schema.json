{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chizumulu.net/schema/subdomain.schema.json",
  "title": "Subdomain registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "records"],
  "properties": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "email"],
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$",
          "description": "GitHub username of the requester"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "content"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["CNAME", "A", "TXT"]
          },
          "name": {
            "type": "string",
            "pattern": "^(@|[A-Za-z0-9_](?:[A-Za-z0-9-_]*[A-Za-z0-9_])?)$",
            "description": "Record name relative to the subdomain, @ for the apex of the subdomain itself"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "ttl": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "proxied": {
            "type": "boolean",
            "description": "레코드별 Cloudflare 프록시 여부, 생략 시 최상위 proxied 값을 따름"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "A" } } },
            "then": { "properties": { "content": { "type": "string", "format": "ipv4" } } }
          }
        ]
      }
    },
    "proxied": {
      "type": "boolean",
      "default": false
    }
  }
}
